# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=hello@bklnsoftware.tech

# App
# En local, deja localhost. En Vercel (producción), pon NEXT_PUBLIC_APP_URL=https://www.bklnsoftware.tech
# — tiene que ser el dominio exacto al que resuelve el sitio (con www, que es al que redirige
# bklnsoftware.tech), si no, el sitemap y las etiquetas Open Graph apuntan a una URL distinta
# de la que ve el visitante.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chat widget
NEXT_PUBLIC_CHAT_API_URL=https://ai.bklnsoftware.tech
